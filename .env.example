# Copy to a local .env and fill in the value there. Never post the key to chat, issues, or Git.
# The hook does NOT auto-load .env from the working directory: export the variable in the
# shell that starts Claude Code, e.g. `export TYPESAFE_API_KEY=...` or `node --env-file=.env ...`.
# Claude models use the existing Claude Code login; no other key is required.
TYPESAFE_API_KEY=
