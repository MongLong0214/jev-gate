# Copy to .env and fill locally. Never post key values to chat, issues, or Git.
# Jev requires a key issued by TypeSafe; another provider's key cannot replace it.
TYPESAFE_API_KEY=

# Use the actual generator provider's existing authorized credentials.
WORKER_API_KEY=
FRONTIER_API_KEY=

# If worker and frontier share one provider account, both config entries may
# reference the same environment-variable name. No key value belongs in config JSON.
