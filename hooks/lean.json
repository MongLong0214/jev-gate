{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/entry.js\" --lean", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/entry.js\" --lean", "timeout": 5}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|TaskStop)$",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/entry.js\" --lean", "timeout": 5}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/entry.js\" --lean", "timeout": 5}
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^jev-gate:(?:worker(?:-fast|-deep|-frontier)?|planner(?:-frontier)?|executor)$",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/entry.js\" --lean", "timeout": 5}
        ]
      }
    ]
  }
}
