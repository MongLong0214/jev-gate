{
  "name": "jev-gate",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code plugin: Jev judges the execution shape, a strong read-only planner decomposes the job, and every worker dispatch is routed to a tier.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p mods/tsconfig.json",
    "test": "vitest run",
    "pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
